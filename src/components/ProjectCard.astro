---
import type { CollectionEntry } from 'astro:content';
const { project, featured = false } = Astro.props as { project: CollectionEntry<'projects'>; featured?: boolean };
const p = project.data;
---
<article class:list={['project-card', { featured }]}><div class="project-main"><div class="card-top"><span class="project-kind">{p.kind} 프로젝트</span><span class="status">{p.status}</span></div><h3><a href={`/projects/${project.id}/`}>{p.title}</a></h3><p>{p.description}</p><ul class="project-highlights">{p.highlights.slice(0,2).map(h=><li>{h}</li>)}</ul></div><div class="card-bottom"><div class="tags">{p.technologies.map(t=><span>{t}</span>)}</div><div class="card-actions"><a class="text-link" href={`/projects/${project.id}/`}>상세 보기<span class="sr-only">: {p.title}</span></a>{p.github && <a href={p.github} target="_blank" rel="noopener noreferrer">GitHub<span class="sr-only">: {p.title} (새 창)</span></a>}</div></div></article>
