---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const periods: Record<string, { label: string; start: string }> = {
  'mcp-tool-composition': { label: '2026.10 ~ 현재', start: '2026-10' },
  'whs-kubernetes': { label: '2026.09 ~ 2026.10', start: '2026-09' },
  'kubernetes-security-lab': { label: '2026.08 ~ 2026.09', start: '2026-08' },
  'ctf-os': { label: '2026.06 ~ 2026.08', start: '2026-06' },
  'bbs': { label: '2026.05 ~ 2026.06', start: '2026-05' },
};
const projects = (await getCollection('projects')).sort((a,b) => {
  const byDate = (periods[b.id]?.start ?? '').localeCompare(periods[a.id]?.start ?? '');
  return byDate || a.data.order - b.data.order;
});
const interests = ['Web Security','Penetration Testing','Infrastructure Security','Kubernetes Security','Cloud Security','Red Team'];
---
<Base title="About | 박현석" description="박현석의 관심 분야와 프로젝트 및 활동 이력">
  <div class="about-page"><div class="wrap about-content">
    <header class="about-intro"><p class="eyebrow">ABOUT · BACKGROUND · ACTIVITY LOG</p><h1>박현석 <span class="english-name">/ Hyunseok Park</span></h1><p>상명대학교 정보보안공학과 학부생입니다. Offensive Security 분야 취업을 목표로 웹, 인프라 모의해킹을 중심으로 공부하고 있습니다.</p></header>
    <div class="about-summary" aria-label="기본 정보"><div><span>EDUCATION</span><strong>상명대학교</strong><p>정보보안공학과 · 2022.03 ~ 현재</p></div><div><span>AFFILIATION</span><strong>WhateverTakes</strong><p>CTF 팀 · 공동 프로젝트 활동</p></div><div><span>FOCUS</span><strong>Web / Infrastructure Security</strong><p>웹 보안 · 인프라 모의해킹</p></div></div>
    <section class="about-section"><div class="section-head"><div><p class="eyebrow">INTERESTS</p><h2>관심 분야</h2></div></div><div class="tags about-tags">{interests.map(interest=><span>{interest}</span>)}</div><p class="section-note">현재는 웹 보안과 인프라 모의해킹을 중심으로 공부하고 있으며, 장기적으로는 클라우드 보안 분야로 학습을 확장하고자 합니다.</p></section>
    <section class="about-section"><div class="section-head"><div><p class="eyebrow">PROJECTS</p><h2>프로젝트와 활동</h2></div><a class="text-link" href="/projects/">프로젝트 목록</a></div><p class="section-note">기간이 확인된 프로젝트를 먼저 표시합니다.</p><ol class="activity-list">{projects.map(project=><li class="activity-item"><div class="activity-date">{periods[project.id]?.label ?? '기간 미기재'}</div><div><div class="activity-meta"><span>{project.data.kind} 프로젝트</span>{project.data.status==='진행 중' && <span> · 진행 중</span>}</div><h3>{project.data.title}</h3><p>{project.id === 'bbs' ? 'Node.js, Express, EJS, Oracle Database 기반 게시판을 구현하고, 회원·게시글·댓글 관리와 인증·인가, CSRF 보호 등 웹 보안 기능을 적용했습니다.' : project.data.description}</p><a class="text-link" href={`/projects/${project.id}/`}>프로젝트 상세<span class="sr-only">: {project.data.title}</span></a></div></li>)}</ol></section>
    <section class="about-section"><div class="section-head"><div><p class="eyebrow">COMPETITIONS</p><h2>대회 참가</h2></div></div><div class="credential-list"><article class="credential"><time datetime="2026-08">2026.08</time><div><strong>2026 KISIA 정보보호 경진대회 · 본선 참가</strong><p>공개 참가 확인서 기준</p></div><a class="text-link" href="https://github.com/shyunseok1029/shyunseok1029/blob/main/assets/certificates/kisia-2026.png" target="_blank" rel="noopener noreferrer">참가 확인서<span class="sr-only"> (새 창)</span></a></article></div></section>
    <section class="about-section"><div class="section-head"><div><p class="eyebrow">EDUCATION</p><h2>교육 및 활동</h2></div></div><div class="credential-list"><article class="credential"><span>2026.06 ~ 2026.12</span><div><strong>화이트햇 스쿨 4기 · 교육 진행 중</strong><p>Kubernetes 보안 팀 프로젝트의 시나리오 조사와 설계·검증에 참여했습니다.</p></div><a class="text-link" href="/projects/whs-kubernetes/">프로젝트 상세</a></article></div></section>
    <section class="about-contact"><div><p class="eyebrow">CONTACT</p><h2>연락</h2><p>공개 프로젝트와 코드는 GitHub에서 확인할 수 있습니다.</p></div><a class="text-link" href="https://github.com/shyunseok1029" target="_blank" rel="noopener noreferrer">GitHub 프로필<span class="sr-only"> (새 창)</span></a></section>
  </div></div>
</Base>
<style>
  .about-page { background: var(--page-background); }
  .about-content { padding-block: 68px 85px; }
  .about-intro { padding-bottom: 35px; margin-bottom: 30px; border-bottom: 1px solid var(--border); }
  .about-intro .eyebrow::before { content: none; }
  .about-intro h1 { font-size: clamp(2.3rem, 4vw, 3.2rem); line-height: 1.25; margin-bottom: 1rem; }
  .english-name { color: var(--secondary-text); font-size: .55em; font-weight: 400; }
  .about-intro > p:not(.eyebrow) { max-width: 760px; color: var(--secondary-text); font-size: 1.0625rem; line-height: 1.9; margin: 0; word-break: keep-all; }
  .about-summary { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: .875rem; }
  .about-summary > div { padding: 1.25rem; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); }
  .about-summary span { color: var(--accent); font-size: .8125rem; display: block; margin-bottom: .55rem; }
  .about-summary strong { display: block; font-size: 1.05rem; }
  .about-summary p { color: var(--secondary-text); font-size: .875rem; margin: .3rem 0 0; }
  .about-section { margin-top: 60px; }
  .section-head { display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 1.4rem; }
  .section-head .eyebrow { margin-bottom: .5rem; }
  .section-head h2 { font-size: clamp(1.7rem, 3vw, 2.3rem); margin: 0; }
  .section-note { color: var(--secondary-text); margin: .75rem 0 1.25rem; font-size: .9375rem; }
  .about-tags span { font-size: .8125rem; }
  .activity-list { list-style: none; padding: 0 0 0 1.4rem; margin: 1.8rem 0 0; border-left: 1px solid #365c4a; }
  .activity-item { position: relative; display: grid; grid-template-columns: 150px minmax(0,1fr); gap: 1.5rem; padding: 0 0 2rem; }
  .activity-item:last-child { padding-bottom: 0; }
  .activity-item::before { position: absolute; content: ''; left: calc(-1.4rem - 4px); top: .5rem; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
  .activity-date, .activity-meta { color: var(--secondary-text); font-size: .8125rem; }
  .activity-item h3 { font-size: 1.15rem; margin: .35rem 0 .45rem; }
  .activity-item p { color: var(--secondary-text); margin: 0 0 .5rem; }
  .credential-list { display: grid; gap: .75rem; }
  .credential { display: grid; grid-template-columns: 140px minmax(0,1fr) auto; align-items: center; gap: 1rem; padding: 1.2rem 1.35rem; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); }
  .credential > span, .credential time { color: var(--accent); font-size: .8125rem; }
  .credential strong { font-size: .95rem; }
  .credential p { color: var(--secondary-text); font-size: .875rem; margin: .25rem 0 0; }
  .about-contact { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; margin-top: 60px; padding: 1.6rem; border: 1px solid #365c4a; border-radius: 8px; background: #142925; }
  .about-contact h2 { font-size: 1.35rem; margin-bottom: .6rem; }
  .about-contact p:not(.eyebrow) { color: var(--secondary-text); margin: 0; }
  @media(max-width:700px) { .about-summary { grid-template-columns: 1fr; } .activity-item { grid-template-columns: 1fr; gap: .35rem; } .credential { grid-template-columns: 1fr auto; } .credential > span, .credential time { grid-column: 1 / -1; } }
  @media(max-width:560px) { .about-content { padding-block: 45px 65px; } .about-intro { padding-bottom: 30px; } .about-intro h1 { font-size: 2.2rem; } .about-intro > p:not(.eyebrow) { font-size: 1rem; } .about-section, .about-contact { margin-top: 45px; } .about-contact { align-items: flex-start; flex-direction: column; } }
</style>
