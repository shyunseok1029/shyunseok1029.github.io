---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { blogCategories } from '../../data/blog-categories';
const posts = (await getCollection('blog', ({data}) => !data.draft)).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const categoriesWithCounts = blogCategories.map(category => ({
  ...category,
  count: posts.filter(post => post.data.category === category.name).length,
}));
---
<Base title="Blog | 박현석" description="보안 학습과 프로젝트에서 이해한 개념과 실습 기록">
  <div class="blog-page"><div class="wrap blog-content">
    <header class="blog-intro"><p class="eyebrow">WRITING · EXPERIENCES · NOTES</p><h1>Blog</h1><p>프로젝트와 보안 실습을 통해 배운 내용과 문제를 해결한 과정을 기록합니다.</p></header>
    <section aria-labelledby="posts-heading">
      <div class="blog-heading"><div><p class="eyebrow">PUBLISHED WRITING</p><h2 id="posts-heading">모든 글 <span>{posts.length}편</span></h2></div><a class="text-link" href="/writeups/">Write-ups</a></div>
      <div class="filter-bar" role="group" aria-label="카테고리 필터"><button type="button" class="filter active" data-category-filter="" aria-pressed="true">전체 <span>{posts.length}</span></button>{categoriesWithCounts.filter(c=>c.count>0).map(c=><button type="button" class="filter" data-category-filter={c.name} aria-pressed="false">{c.name} <span>{c.count}</span></button>)}</div>
      <p id="filter-status" class="sr-only" aria-live="polite"></p>
      <div class="article-list">{posts.map(post=><ArticleCard post={post}/>)}</div>
      <div id="no-results" class="empty" hidden={posts.length>0}><div><strong>{posts.length ? '선택한 카테고리에 글이 없습니다.' : '아직 게시된 글이 없습니다.'}</strong><p>{posts.length ? '다른 카테고리를 선택해 주세요.' : '첫 번째 기술 기록을 준비하고 있습니다.'}</p></div></div>
    </section>
    <section class="blog-topics" aria-labelledby="topics-heading"><div class="blog-heading"><div><p class="eyebrow">WRITING DIRECTIONS</p><h2 id="topics-heading">글을 분류하는 기준</h2></div></div><div class="topic-list">{categoriesWithCounts.map(c=><div><div class="topic-title"><strong>{c.name}</strong><span>{c.count}편</span></div><p>{c.description}</p></div>)}</div><p class="topic-note">공부하며 정리한 내용을 분야별로 모아두었습니다. 글은 계속 추가할 예정입니다.</p></section>
    <section class="blog-github"><p class="eyebrow">SOURCE OF TRUTH</p><h2>코드와 공개는 GitHub에</h2><p>프로젝트의 소스코드와 구현 내용은 GitHub에서 확인할 수 있습니다. 이곳에는 학습 과정과 기술적인 내용을 기록합니다.</p><a class="text-link" href="https://github.com/shyunseok1029" target="_blank" rel="noopener noreferrer">GitHub 프로필 <span aria-hidden="true">↗</span><span class="sr-only"> (새 창)</span></a></section>
  </div></div>
  <script>
    const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-category-filter]')];
    const cards = [...document.querySelectorAll<HTMLElement>('[data-post]')];
    const empty = document.querySelector<HTMLElement>('#no-results');
    const status = document.querySelector<HTMLElement>('#filter-status');
    let category = '';
    function filter() {
      let n = 0;
      for (const card of cards) {
        const show = !category || card.dataset.category === category;
        card.hidden = !show;
        if (show) n++;
      }
      if (empty) empty.hidden = n > 0;
      if (status) status.textContent = `${n}편 표시 중`;
    }
    for (const button of filters) button.addEventListener('click', () => {
      category = button.dataset.categoryFilter || '';
      for (const item of filters) { const active = item === button; item.classList.toggle('active', active); item.setAttribute('aria-pressed', String(active)); }
      filter();
    });
  </script>
</Base>
<style>
  .blog-page { background: var(--page-background); }
  .blog-content { width: min(1110px, calc(100% - 44px)); padding-block: 64px 100px; font-size: 17px; line-height: 1.75; }
  .blog-intro { padding: 10px 0 35px; margin-bottom: 30px; border-bottom: 1px solid var(--border); }
  .blog-content .eyebrow { display: inline-flex; align-items: center; font-size: 11px; font-weight: 800; letter-spacing: .17em; line-height: 1.75; margin: 0; }
  .blog-intro h1 { font-size: clamp(34px, 4vw, 48px); line-height: 1.23; margin: 14px 0; }
  .blog-intro > p:not(.eyebrow) { max-width: 730px; color: var(--secondary-text); font-size: 17px; line-height: 1.95; margin: 0; word-break: keep-all; }
  .blog-heading { display: flex; justify-content: space-between; align-items: end; gap: 15px; margin-bottom: 24px; }
  .blog-heading h2 { font-size: clamp(27px, 3.3vw, 39px); font-weight: 700; line-height: 1.23; margin: 9px 0 0; }
  .blog-heading h2 span { color: var(--secondary-text); font-size: 16px; font-weight: 400; }
  .filter-bar { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 22px; }
  .filter { padding: 7px 13px; color: var(--secondary-text); background: var(--surface); border: 1px solid var(--border); border-radius: 999px; font-size: 12px; line-height: 21px; cursor: pointer; }
  .filter:hover, .filter.active { color: var(--accent); background: #203b30; border-color: #528269; }
  .filter:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  .article-list { display: grid; gap: 12px; }
  .article-list :global(.article-card) { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; padding: 21px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface); }
  .article-list :global(.article-card:hover) { border-color: #63877a; }
  .article-list :global(.article-meta) { display: contents; }
  .article-list :global(.article-meta > span) { grid-column: 1; grid-row: 1; color: var(--accent); font-size: 11px; font-weight: 700; letter-spacing: .1em; }
  .article-list :global(.article-meta > time) { grid-column: 2; grid-row: 1; color: var(--secondary-text); font-size: 13px; }
  .article-list :global(.article-card h3) { grid-column: 1 / -1; font-size: 17px; margin: 8px 0 0; }
  .article-list :global(.article-card p) { grid-column: 1 / -1; font-size: 13px; margin: 5px 0 0; }
  .article-list :global(.article-card .tags) { grid-column: 1 / -1; margin-top: 11px; }
  .article-list :global(.article-card .tags span) { padding: 0; border: 0; background: none; color: var(--secondary-text); font-size: 12px; }
  .article-list :global(.article-card h3 a::after) { content: ''; position: absolute; inset: 0; }
  .blog-topics { margin-top: 60px; }
  .topic-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 11px; }
  .topic-list > div { padding: 19px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface); }
  .topic-title { display: flex; justify-content: space-between; gap: 1rem; }
  .topic-title strong { font-size: 15px; }
  .topic-title span { color: var(--secondary-text); font-size: .8125rem; white-space: nowrap; }
  .topic-list p { color: var(--secondary-text); margin: 5px 0 0; font-size: 13px; }
  .topic-note { color: var(--secondary-text); font-size: 13px; margin: 13px 0 0; }
  .blog-github { margin-top: 60px; padding: 25px; border: 1px solid #365c4a; border-radius: 11px; background: #142925; }
  .blog-github h2 { font-size: 23px; margin: 9px 0; }
  .blog-github p:not(.eyebrow) { max-width: 780px; color: var(--secondary-text); font-size: 14px; margin-bottom: 12px; }
  @media(max-width:620px) { .blog-content { width: calc(100% - 34px); padding-block: 45px 75px; font-size: 16px; } .blog-intro > p:not(.eyebrow) { font-size: 16px; } .topic-list { grid-template-columns: 1fr; } .blog-topics,.blog-github { margin-top: 46px; } .article-list :global(.article-meta > time) { grid-column: 1; grid-row: 5; margin-top: 15px; } }
</style>
