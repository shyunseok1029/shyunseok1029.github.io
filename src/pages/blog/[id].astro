---
import Base from '../../layouts/Base.astro'; import {getCollection,render} from 'astro:content'; export async function getStaticPaths(){const posts=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()); return posts.map((post,i)=>({params:{id:post.id},props:{post,previous:posts[i+1],next:posts[i-1]}}));} const {post,previous,next}=Astro.props; const {Content,headings}=await render(post);
---
<Base title={`${post.data.title} | Blog`} description={post.data.description}><article class="wrap page detail"><a class="back" href="/blog/">블로그 목록</a><div class="detail-head"><p class="eyebrow">{post.data.category} <span class="sep">/</span> <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('ko-KR',{timeZone:'UTC'})}</time></p><h1>{post.data.title}</h1><p class="lead">{post.data.description}</p><div class="tags">{post.data.tags.map((t:string)=><span>#{t}</span>)}</div></div><div class="detail-layout"><div class="prose"><Content/><nav class="post-nav" aria-label="다른 글">{previous && <a href={`/blog/${previous.id}/`}>이전 글<br/><strong>{previous.data.title}</strong></a>}{next && <a href={`/blog/${next.id}/`}>다음 글<br/><strong>{next.data.title}</strong></a>}</nav></div>{headings.length>0 && <aside class="detail-aside toc"><p class="eyebrow">목차</p><nav aria-label="목차"><ul>{headings.filter((h: {depth:number})=>h.depth===2 || h.depth===3).map((h:{depth:number;slug:string;text:string})=><li class:list={{nested:h.depth===3}}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></nav></aside>}</div></article></Base>
